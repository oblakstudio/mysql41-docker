# MySQL 4.1 server configuration for the oblakstudio/mysql41 container.
# Overrides the Sarge default (which binds to 127.0.0.1) so the server is
# reachable across the Docker network.

[client]
port            = 3306
socket          = /var/run/mysqld/mysqld.sock

[mysqld]
user            = mysql
port            = 3306
socket          = /var/run/mysqld/mysqld.sock
pid-file        = /var/run/mysqld/mysqld.pid
datadir         = /var/lib/mysql
bind-address    = 0.0.0.0

# Store the pre-4.1 16-byte password hash to match the legacy source server
# (barel.cloudserver.rs runs old_passwords=ON). Set to 0 for MySQL 4.1's native
# 41-byte SHA1 hash, which modern mysql_native_password clients accept without
# --skip-secure-auth. This must be in effect during first-run init so root/user
# passwords are stored in the chosen format.
old_passwords   = 1

[mysqld_safe]
socket          = /var/run/mysqld/mysqld.sock
